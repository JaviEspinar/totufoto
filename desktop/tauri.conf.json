{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imadive",
  "identifier": "com.waiting4timeout.imadive",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "publisher": "waiting4timeout",
    "homepage": "https://github.com/JaviEspinar/totufoto",
    "copyright": "© 2026 waiting4timeout",
    "license": "AGPL-3.0-only",
    "category": "Photography",
    "shortDescription": "Fast local photo and video gallery with places and people",
    "longDescription": "Imadive indexes your photo and video folders and shows them as a timeline, by place, with upcoming anniversaries and the people found by face recognition. Everything runs on your computer; nothing is uploaded.",
    "linux": {
      "deb": {
        "section": "graphics",
        "depends": ["libheif1"],
        "files": {
          "/usr/share/metainfo/com.waiting4timeout.imadive.metainfo.xml": "linux/com.waiting4timeout.imadive.metainfo.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.waiting4timeout.imadive.metainfo.xml": "linux/com.waiting4timeout.imadive.metainfo.xml"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
