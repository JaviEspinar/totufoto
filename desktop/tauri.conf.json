{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Totufoto",
  "version": "0.1.5",
  "identifier": "com.javiespinar.totufoto",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Photography",
    "shortDescription": "Fast local photo gallery with places and people",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
